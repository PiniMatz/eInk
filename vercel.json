{
  "version": 2,
  "crons": [
    {
      "path": "/api/calendars/sync",
      "schedule": "0 */8 * * *"
    }
  ],
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "fonts/**",
          "db.json"
        ]
      }
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index.js" }
  ]
}
